# Copier en deploy/mysql.env (gitignoré) et renseigner de vrais secrets.
# MYSQL_PASSWORD doit être IDENTIQUE à DB_PASSWORD dans backend/.env — ce sont
# les identifiants du même utilisateur applicatif, vus depuis deux fichiers
# différents (le conteneur mysql qui le crée, Laravel qui s'y connecte).

MYSQL_ROOT_PASSWORD=change-me-strong-random-root-password
MYSQL_PASSWORD=change-me-strong-random-app-password
