# Gabarit de production — copier en backend/.env (gitignoré) et compléter les
# valeurs marquées ⚠️. Base : backend/.env.example (dev), avec les valeurs
# production déjà appliquées ci-dessous et commentées quand elles diffèrent.
# Voir deploy/README.md pour la checklist complète de premier déploiement.

APP_NAME="La baie des lacs"
APP_TAGLINE="L'hospitalité ivoirienne, sublimée."
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.votredomaine.com
APP_TIMEZONE=UTC
APP_LOCALE=fr

# Doit correspondre à APP_DOMAIN du .env racine (celui utilisé par le SPA).
FRONTEND_URLS=https://votredomaine.com
FRONTEND_URL=https://votredomaine.com

# ⚠️  Générer avec : docker compose run --rm backend php artisan key:generate --show
# puis coller la valeur ici (ne JAMAIS laisser vide, ne jamais commiter la vraie clé).
APP_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# host = nom du service docker-compose (mysql), pas localhost/127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hotel_management
DB_USERNAME=hotel_app
# ⚠️  Doit être IDENTIQUE à MYSQL_PASSWORD dans deploy/mysql.env.
DB_PASSWORD=
DB_TIMEZONE=+00:00

# En dev, QUEUE_CONNECTION=sync bloque la requête HTTP le temps de traiter le
# job (acceptable en local). En production : `database` + le service `queue`
# (docker-compose.yml) qui tourne en continu via `queue:work`.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
# Le SPA n'utilise que des tokens Sanctum (bearer, pas de cookie de session) —
# ces réglages ne s'appliquent qu'aux quelques routes web internes de Laravel.
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.votredomaine.com

FILESYSTEM_DISK=local

RESERVATION_UNPAID_TIMEOUT_HOURS=24
RESERVATION_FAILED_TIMEOUT_MINUTES=120

# ⚠️  Fortement recommandé en production pour être alerté des erreurs 500.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ⚠️  Vrai fournisseur SMTP transactionnel (pas Mailtrap) : Mailgun, SES, Brevo…
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@votredomaine.com
MAIL_FROM_NAME="${APP_NAME}"

# ⚠️  Credentials OAuth Google PRODUCTION (projet Google Cloud séparé du
# dev, redirect URI = le domaine réel).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# JAMAIS true en production — voir SecurityHardeningTest / la route
# /payments/{id}/simulate n'est de toute façon enregistrée qu'en local/testing.
PAYMENT_SIMULATION=false
PAYMENT_EXPIRY_MINUTES=30

# ⚠️  Credentials agrégateurs réels — vides = paiement en ligne indisponible.
ORANGE_CI_API_URL=https://api.orange.com/orange-money-webpay/ci/v1
ORANGE_CI_MERCHANT_KEY=
ORANGE_CI_WEBHOOK_SECRET=

WAVE_CI_API_URL=https://api.wave.com/v1
WAVE_CI_API_KEY=
WAVE_CI_WEBHOOK_SECRET=

BROADCAST_CONNECTION=reverb

# ⚠️  Générer des identifiants propres à la prod (ex. `php artisan reverb:install`
# ou aléatoires manuels) — REVERB_APP_KEY doit être IDENTIQUE à REVERB_APP_KEY
# dans le .env racine (build du frontend). Ne jamais réutiliser les valeurs dev.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.votredomaine.com
REVERB_PORT=443
REVERB_SCHEME=https
# Écoute interne du process reverb (dans le conteneur, derrière Caddy) —
# ne pas confondre avec REVERB_HOST/PORT ci-dessus (publiques, côté client).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

SESSION_IDLE_MINUTES=30
SESSION_REMEMBER_MINUTES=10080
