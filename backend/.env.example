APP_NAME="La baie des lacs"
APP_TAGLINE="La gestion hôtelière, simplifiée."
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

# Frontend SPA — comma-separated list of allowed origins (CORS)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# ⚠️  Ne jamais commiter la vraie clé. Générer avec : php artisan key:generate
APP_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# En développement : single | En production : daily (rotation quotidienne)
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# En développement : debug | En production : error
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_management
DB_USERNAME=root
# ⚠️  Ne jamais laisser vide en production
DB_PASSWORD=your-strong-database-password
DB_TIMEZONE=+00:00

# sync = traitement immédiat (dev). En production : `database` ou `redis`
# + un worker (`php artisan queue:work`) pour que l'envoi des e-mails
# (vérification, réinitialisation) ne bloque plus la requête HTTP.
QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=file

FILESYSTEM_DISK=local

# Délai (heures) avant annulation automatique d'une réservation JAMAIS payée.
# Commande planifiée : `reservations:cancel-unpaid` (toutes les 15 min).
RESERVATION_UNPAID_TIMEOUT_HOURS=24

# Délai (minutes) avant libération d'une réservation dont la DERNIÈRE tentative
# de paiement a échoué (ex. solde insuffisant) sans nouvelle tentative. Plus
# court que le délai ci-dessus : le temps de recharger son compte et réessayer.
RESERVATION_FAILED_TIMEOUT_MINUTES=120

# Monitoring des erreurs (Sentry). Laisser vide = désactivé (aucun événement
# envoyé). Renseigner le DSN du projet pour activer la remontée en production.
SENTRY_LARAVEL_DSN=
# Taux d'échantillonnage des traces de performance (0 = aucune, 1 = toutes).
SENTRY_TRACES_SAMPLE_RATE=0.1

# Mail — Remplacer par vos identifiants SMTP réels (Mailtrap, Mailgun, SES...)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM_ADDRESS=noreply@hotel.local
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth — Créer les credentials sur https://console.cloud.google.com > APIs & Services > Credentials
# ⚠️  Ne jamais commiter les vraies valeurs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Orange Money CI Payment — https://developer.orange.com
ORANGE_CI_API_URL=https://api.orange.com/orange-money-webpay/ci/v1
ORANGE_CI_MERCHANT_KEY=
ORANGE_CI_WEBHOOK_SECRET=

# Wave CI Payment — https://docs.wave.com
WAVE_CI_API_URL=https://api.wave.com/v1
WAVE_CI_API_KEY=
WAVE_CI_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:5173

# ── Diffusion temps réel (WebSocket via Laravel Reverb) ──────────────
# Requis pour les mises à jour en direct (planning, notifications, badges…).
# Démarrer le serveur avec : `php artisan reverb:start`
BROADCAST_CONNECTION=reverb

# ⚠️  Générer des identifiants propres au projet — ne jamais commiter les vrais.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Les variables VITE_* correspondantes vivent côté frontend (frontend/.env) :
# le backend est une API pure et n'embarque plus de build Vite.

# Expiration des tokens API en minutes (10080 = 7 jours). Vide = jamais.
SANCTUM_TOKEN_EXPIRATION=10080
