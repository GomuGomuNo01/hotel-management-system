# Variables consommées par docker-compose.yml et deploy/Caddyfile (PAS par
# Laravel — ça, c'est backend/.env, séparé). Copier en .env à la racine du
# repo avant `docker compose up`.
#
# Ce fichier est distinct de backend/.env.production.example : celui-ci pilote
# l'orchestration (domaines, build du frontend) ; l'autre pilote l'application
# Laravel elle-même (mail, OAuth, paiement…).

# ── Domaines (DNS → IP du VPS, ports 80/443 ouverts avant le premier démarrage) ──
API_DOMAIN=api.votredomaine.com
APP_DOMAIN=votredomaine.com
WS_DOMAIN=ws.votredomaine.com
ACME_EMAIL=admin@votredomaine.com

# ── MySQL (nom de base / utilisateur applicatif — les mots de passe sont dans
#    deploy/mysql.env, gitignoré, PAS ici) ──
DB_DATABASE=hotel_management
DB_USERNAME=hotel_app

# ── Build du frontend (figées dans le bundle JS, cf. frontend/Dockerfile) ──
VITE_API_URL=https://api.votredomaine.com/api
VITE_APP_NAME=La baie des lacs
VITE_GOOGLE_REDIRECT_URL=https://api.votredomaine.com/api/auth/google/redirect
VITE_REVERB_HOST=ws.votredomaine.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Doit être IDENTIQUE à REVERB_APP_KEY dans backend/.env (même app Reverb, vue
# côté client et côté serveur).
REVERB_APP_KEY=
